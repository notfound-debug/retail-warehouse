# Copy this file to .env and set your own passwords. .env is gitignored.
# Do not put comments on the same line as a value (Docker treats them as part of the value).

# Password for SYS and SYSTEM. Only the database image and the init script use it.
ORACLE_PASSWORD=ChangeMeSys1

# The warehouse schema. All tables, packages and views live here.
DW_USER=dw
DW_PASSWORD=ChangeMeDw1

# How the tools container reaches the database: host:port/service (XEPDB1 is the pluggable DB).
DW_CONNECT=oracle:1521/XEPDB1

# Timezone for both containers. cron runs the nightly load at 02:00 in this zone.
TZ=UTC

# Read-only reporting user for other applications (e.g. a reporting portal).
# Created on the database's first start; it can only SELECT the 12 DW.V_RPT_* views.
REPORT_USER=dw_report
REPORT_PASSWORD=ChangeMeReport1

# Optional command that bin/nightly_load.sh runs before every load, inside the tools
# container (e.g. an extract validator). Exit code 0 = load; anything else = skip the
# load (the wrapper exits 5). Leave empty for no check.
# {mode} and {source} are replaced with the load mode (full/delta) and directory
# (RAW_DIR/DELTA_DIR/TEST_DIR). Do not use "$": Docker Compose also reads this file.
# Example: PRELOAD_CHECK=curl -sS --fail-with-body --max-time 600 "http://validator:8080/check?mode={mode}&source={source}"
PRELOAD_CHECK=
